{
  "name": "privacymatrix",
  "version": "0.1.0",
  "private": true,
  "description": "Does this AI app train on your chats? 28 AI assistant apps, 14 privacy questions; every cell quotes the vendor's own policy; quotes are checked weekly where the source can be read.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barbarkaragul-oss/privacymatrix"
  },
  "homepage": "https://barbarkaragul-oss.github.io/privacymatrix/",
  "engines": {
    "node": "^22.19.0 || >=24.6.0"
  },
  "scripts": {
    "check": "node scripts/run-node.mjs --import tsx src/check.ts",
    "residential": "node scripts/run-node.mjs --experimental-strip-types scripts/residential.ts",
    "verify": "node scripts/run-node.mjs --import tsx src/verify.ts",
    "build": "tsx src/generate.ts",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:no-git": "node --import tsx --test --test-skip-pattern retryBaseReset \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run build",
    "manual": "node scripts/run-node.mjs --import tsx scripts/manual.ts",
    "attest": "tsx src/attest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
